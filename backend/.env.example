# Server (use 5001 on macOS — port 5000 is often used by AirPlay)
PORT=5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/repo_app

# JWT
JWT_SECRET=change-me

# AWS S3 — Excel files (required)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=fastrecovery
AWS_S3_UPLOAD_PREFIX=uploads

# Redis / Upstash — optional BullMQ queue (set UPLOAD_USE_QUEUE=true and run npm run worker:dev)
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
# UPLOAD_USE_QUEUE=false

# Upload policy — S3 only by default (does NOT fill MongoDB Atlas)
# ENABLE_MONGO_IMPORT=true
MAX_UPLOAD_ROWS=2500000
MAX_MONGO_IMPORT_ROWS=50000
EXCEL_CHUNK_SIZE=1000
UPLOAD_WORKER_CONCURRENCY=2
