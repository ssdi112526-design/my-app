# Server (use 5001 on macOS — port 5000 is often used by AirPlay)
PORT=5001

# PostgreSQL (Render External URL from local machines; Internal URL from Render services)
# Do not commit the real password. Copy from Render and keep it in backend/.env only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional — only for one-time MongoDB → PostgreSQL data copy (`npm run migrate:mongo`)
# MONGO_URI=mongodb://127.0.0.1:27017/repo_app

# JWT
JWT_SECRET=change-me

# AWS S3 — Excel files (required)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=fastrecovery
AWS_S3_UPLOAD_PREFIX=uploads

# Redis / Upstash — required for production BullMQ worker
# REST keys are optional. BullMQ needs native REDIS_URL (rediss://), not HTTPS REST.
# UPSTASH_REDIS_REST_URL=https://YOUR_HOST.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
UPLOAD_USE_QUEUE=true
# UPLOAD_JOB_ATTEMPTS=3
# UPLOAD_JOB_BACKOFF_MS=5000
# UPLOAD_LOCK_DURATION_MS=600000
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Upload policy — S3 only by default (set ENABLE_MONGO_IMPORT=true to also import rows into the database)
# ENABLE_MONGO_IMPORT=true
MAX_UPLOAD_ROWS=2500000
MAX_MONGO_IMPORT_ROWS=50000
EXCEL_CHUNK_SIZE=1000
UPLOAD_SEARCH_CHUNK_SIZE=1000
UPLOAD_WORKER_CONCURRENCY=2
# Typed search prefix guard (Find Vehicles already uses 4). 0 disables.
# SEARCH_MIN_PREFIX_LENGTH=4
# Search-only PostgreSQL statement_timeout in ms. 0 disables.
# SEARCH_STATEMENT_TIMEOUT_MS=20000
# SEARCH_MAX_LIMIT=500
MAX_UPLOAD_FILE_SIZE_MB=150
RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT=30
# SEARCH_RATE_LIMIT=120
# UPLOAD_RATE_LIMIT=40
# API_RATE_LIMIT=300
